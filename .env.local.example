# ── Performance & Talent (Balanced Scorecard) — environment ──
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase project. Browser + server clients.
#   used by: lib/supabase/client.ts, lib/supabase/server.ts
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Supabase service-role (secret) key. Server-side only — NEVER expose to the browser.
# perf_people / perf_kpi_definitions / perf_kpi_actuals have RLS enabled with NO
# client policies — every read and write goes through app/actions.ts using this
# key. If it is missing or misnamed, all data operations fail (loudly, not silently).
#   used by: lib/supabase/service.ts (via app/actions.ts)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Which brand skin to render: 'dcupside' (default if unset) or 'mrpg'.
# See lib/brand.ts. Leave unset for local dev unless testing the mrpg skin.
NEXT_PUBLIC_BRAND=mrpg
